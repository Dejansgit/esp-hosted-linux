CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_SDIO_DAT2_DISABLED=

# BT Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=
CONFIG_BTDM_CONTROLLER_MODE_BTDM=y
CONFIG_BTDM_CONTROLLER_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_AUTO_LATENCY=y

CONFIG_ESP32_WIFI_NVS_ENABLED=

# BT over UART
# Enable below config and delete sdkconfig, build/ and rebuild for UART HCI
#CONFIG_BTDM_CONTROLLER_HCI_MODE_UART_H4=y
#CONFIG_BTDM_CTRL_HCI_MODE_UART_H4=y
#CONFIG_BT_HCI_UART_NO=1
#CONFIG_BT_HCI_UART_BAUDRATE=921600
#CONFIG_BT_HCI_UART_FLOW_CTRL_EN=y
#CONFIG_BT_HCI_UART_TX_PIN=5
#CONFIG_BT_HCI_UART_RX_PIN=18
#CONFIG_BT_HCI_UART_CTS_PIN=23
#CONFIG_BT_HCI_UART_RTS_PIN=19

#CO-EX config
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP32_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_BTDM_CONTROLLER_PINNED_TO_CORE=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=40
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA=y

# iram text optimization
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# xWave Edge: ESP32-WROVER on the WiFi+GPS V4.2 communication board, SPI transport.
# The board routes the SPI lines through the GPIO matrix (CS 34, SCLK 35, MOSI 36
# are input-only pins, MISO on 4); handshake IO2 -> MP157 PH8, data ready IO32 -> PH9,
# EN -> PH3. See ODYSSEY docs/WiFi-Plan.md.
CONFIG_ESP_SPI_HOST_INTERFACE=y
CONFIG_ESP_SPI_CONTROLLER=2
CONFIG_ESP_SPI_GPIO_HANDSHAKE=2
CONFIG_ESP_SPI_GPIO_DATA_READY=32
CONFIG_ESP_SPI_GPIO_MOSI=36
CONFIG_ESP_SPI_GPIO_MISO=4
CONFIG_ESP_SPI_GPIO_SCLK=35
CONFIG_ESP_SPI_GPIO_CS=34
# The STM32MP1 SPI driver releases its GPIO chip select some time after the last
# clock. Without this the slave arms the next transaction while CS is still low,
# that transaction ends with 0 bits when CS rises, and its frame is lost (seen
# on the bench 2026-11-03: 9 of 10 replies lost).
CONFIG_ESP_SPI_DEASSERT_HS_ON_CS=y
# Mesh mode (W8): the ESP's own TCP/IP stack forwards and translates between
# the link to Linux, the mesh and a router.
CONFIG_XWAVE_MESH=y
CONFIG_XWAVE_MESH_ROUTE_TABLE_SIZE=50
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y

# No Bluetooth on the Edge: the product does not use it and the mesh stack
# needs the flash it took (W8).
# CONFIG_BT_ENABLED is not set
